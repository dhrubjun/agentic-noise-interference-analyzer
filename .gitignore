# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class


# Virtual environments
.venv/
venv/
env/
ENV/


# Python packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/


# Pytest / test caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/


# Type checker / linter caches
.mypy_cache/
.ruff_cache/


# Jupyter Notebook checkpoints
.ipynb_checkpoints/


# IDE / editor files
.vscode/
.idea/
*.swp
*.swo


# Operating system files
.DS_Store
Thumbs.db
desktop.ini


# Environment variables / secrets
.env
.env.*
!.env.example


# Logs
*.log


# Temporary files
*.tmp
*.temp
*.bak
*~


# Generated analysis outputs
outputs/*
!outputs/.gitkeep


# Generated plots / figures inside output directories
*.png
*.svg
*.pdf


# Local experimental scratch data
experiments/tmp/
experiments/scratch/


# Large/raw local datasets
data/raw/
test_data/external/


# NumPy / binary signal dumps generated locally
*.npy
*.npz


# Python profiling
*.prof


# Local application state
.cache/